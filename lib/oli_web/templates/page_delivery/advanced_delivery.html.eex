
<!-- ACTIVITIES -->
<%= for %{slug: slug, authoring_script: script} <- @activity_types do %>
  <%= if slug == "oli_adaptive" do %>
    <!-- <%= slug %> -->
    <script type="text/javascript" src="<%= Routes.static_path(@conn, "/js/" <> script) %>"></script>
  <% end %>
<% end %>

<!-- PARTS -->
<%= for script <- @part_scripts do %>
  <script type="text/javascript" src="<%= Routes.static_path(@conn, "/js/" <> script) %>"></script>
<% end %>

<script type="text/javascript" src="<%= Routes.static_path(@conn, "/js/delivery.js") %>"></script>

<div id="delivery_container">
  <%= if match?(%{scope: %{}}, @conn.assigns[:user_session]) do %>
    <%= OliWeb.Components.SecureAssessment.shell(%{inner_block: [%{__slot__: :inner_block, inner_block: fn _, _ -> react_component("Components.Delivery", @app_params) end}]}) %>
  <% else %>
    <%= react_component("Components.Delivery", @app_params) %>
  <% end %>
</div>

<%= if @mount_dialogue_window? and not match?(%{scope: %{}}, @conn.assigns[:user_session]) do %>
  <%= live_render(@conn, OliWeb.Dialogue.WindowLive,
    session: %{
      "secure_session_id" => @conn.assigns[:user_session] && @conn.assigns.user_session.token_id,
      "section_slug" => @section_slug,
      "resource_id" => @resource_id,
      "revision_id" => @revision.id,
      "adaptive_delivery_view" => if(@revision.content["displayApplicationChrome"], do: "adaptive_with_chrome", else: "adaptive_chromeless")
    }
  ) %>
<% end %>


<script>
  // Used in assets/src/phoenix/socket.ts
  window.userToken = "<%= assigns[:user_token] %>";
</script>

<%= if Oli.Utils.LoadTesting.enabled?() do %>
<!--
__FINALIZATION_URL__<%= encode_url(Routes.page_lifecycle_path(@conn, :transition)) %>__FINALIZATION_URL__

__ACTIVITY_ATTEMPTS__<%= encode_activity_attempts(@activity_type_slug_mapping, @latest_attempts) %>__ACTIVITY_ATTEMPTS__
-->
<% end %>
