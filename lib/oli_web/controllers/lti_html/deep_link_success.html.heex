<!DOCTYPE html>
<html>
  <head>
    <title>Deep Linking Complete</title>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        padding: 20px;
        text-align: center;
      }
      .success {
        color: #22c55e;
        margin: 20px 0;
      }
      .content-item {
        background: #f8fafc;
        padding: 15px;
        border-radius: 8px;
        margin: 10px 0;
      }
    </style>
  </head>
  <body>
    <div class="success">
      <h2>Resource Selected Successfully</h2>
      <div class="content-item">
        <h3>{@content_item["title"] || "Selected Resource"}</h3>
        <%= if @content_item["text"] do %>
          <p>{@content_item["text"]}</p>
        <% end %>
        <%= if @content_item["url"] do %>
          <p><strong>URL:</strong> {@content_item["url"]}</p>
        <% end %>
      </div>
      <p>This window will close automatically...</p>
    </div>
    <div
      id="section-deep-link-result"
      data-result={
        Jason.encode!(%{
          type: "lti_deep_linking_response",
          status: "success",
          request_id: @request_id,
          content_item: @content_item
        })
      }
    >
    </div>
    <script>
      if (window.parent !== window) {
        const result = JSON.parse(document.getElementById('section-deep-link-result').dataset.result);
        window.parent.postMessage(result, window.location.origin);

        window.parent.postMessage({
          type: 'lti_close_modal'
        }, window.location.origin);

        setTimeout(() => {
          window.close();
        }, 2000);
      }
    </script>
  </body>
</html>
