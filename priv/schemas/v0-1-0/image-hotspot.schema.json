{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/image-hotspot.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Image Hotspot activity model",
  "description": "Authored Image Hotspot structure with shared content. Domain evaluation and readiness checks are separate.",
  "type": "object",
  "properties": {
    "stem": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/content"
    },
    "imageURL": {
      "type": "string"
    },
    "height": {
      "type": "number"
    },
    "width": {
      "type": "number"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/choice/properties/id"
          },
          "content": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/choice/properties/content"
          },
          "editor": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/choice/properties/editor"
          },
          "textDirection": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/choice/properties/textDirection"
          },
          "frequency": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/choice/properties/frequency"
          },
          "coords": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "content",
          "coords"
        ],
        "additionalProperties": false
      }
    },
    "multiple": {
      "type": "boolean"
    },
    "authoring": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/part-with-match-config"
          }
        },
        "correct": {
          "type": "array",
          "items": [
            {
              "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/choice-response-association/items/0"
            },
            {
              "type": "string"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "additionalItems": false,
          "description": "The single-selection factory uses [[], \"\"] as an unset association; reference integrity is deferred."
        },
        "targeted": {
          "type": "array",
          "items": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/choice-response-association"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/transformation"
          }
        },
        "previewText": {
          "type": "string"
        }
      },
      "required": [
        "parts",
        "correct",
        "targeted",
        "transformations",
        "previewText"
      ],
      "additionalProperties": false
    },
    "id": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/id"
    },
    "activity_id": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/activity_id"
    },
    "resourceId": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/resourceId"
    },
    "learningLanguage": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/learningLanguage"
    },
    "bibrefs": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/bibrefs"
    },
    "activityType": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/activityType"
    },
    "content": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/content"
    }
  },
  "required": [
    "stem",
    "choices",
    "multiple",
    "authoring"
  ],
  "additionalProperties": false
}
