{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/page-content-adaptive.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Adaptive Page Content",
  "description": "Persisted Adaptive Page content and authoring wire content: deck groups, sequence references, and lesson settings.",
  "type": "object",
  "properties": {
    "advancedAuthoring": {
      "const": true
    },
    "advancedDelivery": {
      "const": true
    },
    "model": {
      "type": "array",
      "items": {
        "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/adaptive-page-components.schema.json#/$defs/deck-group"
      }
    },
    "additionalStylesheets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "custom": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/adaptive-page-components.schema.json#/$defs/lesson-custom"
    },
    "customCss": {
      "type": "string"
    },
    "customScript": {
      "type": "string"
    },
    "displayApplicationChrome": {
      "type": "boolean"
    },
    "version": {
      "const": "0.1.0"
    }
  },
  "required": [
    "advancedAuthoring",
    "advancedDelivery",
    "model"
  ],
  "additionalProperties": false
}
