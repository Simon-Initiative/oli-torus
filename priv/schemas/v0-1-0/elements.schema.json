{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/elements.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Elements",
  "description": "List of basic page elements",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "type"
    ],
    "properties": {
      "type": {
        "enum": [
          "content",
          "group",
          "survey",
          "alternatives",
          "break",
          "activity-reference",
          "selection",
          "report"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "content"
            }
          },
          "type": "object",
          "required": [
            "type"
          ]
        },
        "then": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-block.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "group"
            }
          },
          "type": "object",
          "required": [
            "type"
          ]
        },
        "then": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-group.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "survey"
            }
          },
          "type": "object",
          "required": [
            "type"
          ]
        },
        "then": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-survey.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "alternatives"
            }
          },
          "type": "object",
          "required": [
            "type"
          ]
        },
        "then": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-alternatives.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "break"
            }
          },
          "type": "object",
          "required": [
            "type"
          ]
        },
        "then": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-break.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "activity-reference"
            }
          },
          "type": "object",
          "required": [
            "type"
          ]
        },
        "then": {
          "oneOf": [
            {
              "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-reference.schema.json"
            },
            {
              "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-sequence.schema.json"
            }
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "selection"
            }
          },
          "type": "object",
          "required": [
            "type"
          ]
        },
        "then": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-bank-selection.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "report"
            }
          },
          "type": "object",
          "required": [
            "type"
          ]
        },
        "then": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-report.schema.json"
        }
      }
    ]
  }
}
