{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-block.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Content Block",
  "description": "A content block is an ordered collection of block level content elements such as paragraph, image, codeblock, etc.",
  "type": "object",
  "properties": {
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "type": {
      "const": "content"
    },
    "children": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-element.schema.json#/$defs/rich-text"
    },
    "editor": {
      "enum": [
        "slate",
        "markdown"
      ]
    },
    "textDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    }
  },
  "required": [
    "type",
    "children"
  ]
}
