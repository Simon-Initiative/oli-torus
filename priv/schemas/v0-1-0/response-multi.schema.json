{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/response-multi.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Response Multi activity model",
  "description": "Strict authored Response Multi configuration sharing the Multi Input input, content and part contracts.",
  "type": "object",
  "properties": {
    "stem": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/stem"
    },
    "choices": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/choices"
    },
    "inputs": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/inputs"
    },
    "submitPerPart": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/submitPerPart"
    },
    "customScoring": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/customScoring"
    },
    "scoringStrategy": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/scoringStrategy"
    },
    "id": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/id"
    },
    "activity_id": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/activity_id"
    },
    "resourceId": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/resourceId"
    },
    "learningLanguage": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/learningLanguage"
    },
    "bibrefs": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/bibrefs"
    },
    "activityType": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/activityType"
    },
    "content": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/content"
    },
    "multInputsPerPart": {
      "type": "boolean"
    },
    "authoring": {
      "type": "object",
      "properties": {
        "parts": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/authoring/properties/parts"
        },
        "transformations": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/authoring/properties/transformations"
        },
        "previewText": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/authoring/properties/previewText"
        },
        "targeted": {
          "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/multi-input.schema.json#/properties/authoring/properties/targeted"
        },
        "responses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user_name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "user_name",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "parts",
        "transformations",
        "previewText",
        "targeted"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "stem",
    "choices",
    "inputs",
    "submitPerPart",
    "authoring",
    "multInputsPerPart"
  ],
  "additionalProperties": false
}
