{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-group.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Content Group",
  "description": "A grouping of content with a particular layout",
  "type": "object",
  "properties": {
    "type": {
      "const": "group"
    },
    "id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "layout": {
      "enum": [
        "vertical",
        "deck"
      ]
    },
    "paginationMode": {
      "enum": [
        "normal",
        "manualReveal",
        "automatedReveal"
      ]
    },
    "purpose": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/purpose-type.schema.json"
    },
    "audience": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/audience.schema.json"
    },
    "children": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/elements.schema.json"
    },
    "trigger": {
      "type": "object",
      "properties": {
        "type": {
          "const": "trigger"
        },
        "id": {
          "type": "string"
        },
        "trigger_type": {
          "const": "group"
        },
        "prompt": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "trigger_type",
        "prompt"
      ]
    }
  },
  "required": [
    "type",
    "layout",
    "purpose",
    "children"
  ]
}
