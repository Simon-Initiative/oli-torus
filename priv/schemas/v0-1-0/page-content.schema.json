{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/page-content.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Page Content",
  "description": "Dispatches by explicit Adaptive flags. Malformed Adaptive content cannot fall through to Basic Page validation.",
  "type": "object",
  "properties": {
    "advancedAuthoring": {
      "type": "boolean"
    },
    "advancedDelivery": {
      "type": "boolean"
    }
  },
  "if": {
    "anyOf": [
      {
        "required": [
          "advancedAuthoring"
        ],
        "properties": {
          "advancedAuthoring": {
            "const": true
          }
        }
      },
      {
        "required": [
          "advancedDelivery"
        ],
        "properties": {
          "advancedDelivery": {
            "const": true
          }
        }
      }
    ]
  },
  "then": {
    "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/page-content-adaptive.schema.json"
  },
  "else": {
    "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/page-content-basic.schema.json"
  }
}
