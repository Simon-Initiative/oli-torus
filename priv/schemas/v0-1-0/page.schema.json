{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/page.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Workbook Page",
  "description": "A workbook page that contains learning materials and activities",
  "type": "object",
  "properties": {
    "type": {
      "const": "Page"
    },
    "id": {
      "type": "string"
    },
    "content": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/page-content.schema.json"
    },
    "isGraded": {
      "type": "boolean"
    },
    "objectives": {
      "if": {
        "type": "array"
      },
      "then": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "attached": {
            "type": "array"
          }
        }
      }
    },
    "originalFile": {
      "type": "string"
    },
    "tags": {
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "unresolvedReferences": {
      "type": "array"
    },
    "aiEnabled": {
      "type": "boolean"
    },
    "purpose": {
      "enum": [
        "foundation",
        "application",
        "deliberate_practice",
        null
      ]
    },
    "relatesTo": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "integer"
        ]
      }
    },
    "introContent": {
      "type": [
        "object",
        "null"
      ]
    },
    "introVideo": {
      "type": [
        "string",
        "null"
      ]
    },
    "posterImage": {
      "type": [
        "string",
        "null"
      ]
    },
    "scoringStrategyId": {
      "type": [
        "integer",
        "null"
      ]
    },
    "maxAttempts": {
      "type": [
        "integer",
        "null"
      ]
    },
    "recommendedAttempts": {
      "type": [
        "integer",
        "null"
      ]
    },
    "durationMinutes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "fullProgressPct": {
      "type": [
        "integer",
        "null"
      ]
    },
    "retakeMode": {
      "enum": [
        "normal",
        "targeted",
        null
      ]
    },
    "assessmentMode": {
      "enum": [
        "traditional",
        "one_at_a_time",
        null
      ]
    },
    "collabSpace": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "enum": [
            "disabled",
            "enabled",
            "archived",
            null
          ]
        },
        "threaded": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "auto_accept": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "show_full_history": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "anonymous_posting": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "participation_min_replies": {
          "type": [
            "integer",
            "null"
          ]
        },
        "participation_min_posts": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "explanationStrategy": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "after_max_resource_attempts_exhausted",
            "after_set_num_attempts",
            null
          ]
        },
        "set_num_attempts": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "content",
    "isGraded",
    "objectives",
    "tags",
    "title",
    "type"
  ]
}
