{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/directed-discussion.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Directed Discussion activity model",
  "description": "Strict authored Directed Discussion configuration. Participation ranges and completion policies remain domain concerns.",
  "type": "object",
  "properties": {
    "stem": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/content"
    },
    "participation": {
      "type": "object",
      "properties": {
        "minPosts": {
          "type": "number"
        },
        "maxPosts": {
          "type": "number"
        },
        "minReplies": {
          "type": "number"
        },
        "maxReplies": {
          "type": "number"
        },
        "maxWordLength": {
          "type": "number"
        }
      },
      "required": [
        "minPosts",
        "maxPosts",
        "minReplies",
        "maxReplies",
        "maxWordLength"
      ],
      "additionalProperties": false
    },
    "maxWords": {
      "type": "number"
    },
    "authoring": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/part-with-match-config"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/transformation"
          }
        }
      },
      "required": [
        "version",
        "parts",
        "transformations"
      ],
      "additionalProperties": false
    },
    "id": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/id"
    },
    "activity_id": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/activity_id"
    },
    "resourceId": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/resourceId"
    },
    "learningLanguage": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/learningLanguage"
    },
    "bibrefs": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/bibrefs"
    },
    "activityType": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/activityType"
    },
    "content": {
      "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/activity-components.schema.json#/$defs/model-metadata/properties/content"
    }
  },
  "required": [
    "stem",
    "participation",
    "maxWords",
    "authoring"
  ],
  "additionalProperties": false
}
