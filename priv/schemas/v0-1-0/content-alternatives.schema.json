{
  "$id": "http://torus.oli.cmu.edu/schemas/v0-1-0/content-alternatives.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Content Alternatives",
  "description": "A placement of a referenced Alternatives group and its local option content",
  "type": "object",
  "properties": {
    "type": {
      "const": "alternatives"
    },
    "id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alternative"
      }
    },
    "alternatives_id": {
      "type": "integer"
    }
  },
  "required": [
    "type",
    "id",
    "alternatives_id",
    "children"
  ],
  "$defs": {
    "alternative": {
      "type": "object",
      "properties": {
        "type": {
          "const": "alternative"
        },
        "id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "value": {
          "type": [
            "string"
          ]
        },
        "children": {
          "allOf": [
            {
              "$ref": "http://torus.oli.cmu.edu/schemas/v0-1-0/elements.schema.json"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonAlternativesDescendant"
              }
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "value",
        "children"
      ]
    },
    "nonAlternativesDescendant": {
      "allOf": [
        {
          "not": {
            "type": "object",
            "properties": {
              "type": {
                "const": "alternatives"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "children": {
                "type": "array"
              }
            },
            "required": [
              "children"
            ]
          },
          "then": {
            "properties": {
              "children": {
                "items": {
                  "$ref": "#/$defs/nonAlternativesDescendant"
                }
              }
            }
          }
        }
      ]
    }
  }
}
