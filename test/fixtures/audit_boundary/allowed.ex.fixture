defmodule Oli.Accounts.AuditBoundaryConsumer do
  def probe do
    {Oli.Accounts.__info__(:functions), Oli.Accounts.Audited.__info__(:functions),
     OliWeb.__info__(:functions)}
  end
end

defmodule OliWeb.AuditBoundaryConsumer do
  def probe, do: {Oli.Accounts.Audited.__info__(:functions), ECL.Constellation.__info__(:functions)}
end

defmodule Oli.Scenarios.AuditBoundaryConsumer do
  def probe, do: Oli.Accounts.Audited.__info__(:functions)
end

defmodule Oli.Accounts.Audited.CompilerProbe do
  def probe do
    {Oli.Accounts.Audited.Mutations.__info__(:functions),
     Oli.Accounts.Audited.Replay.__info__(:functions)}
  end
end

defmodule Mix.Tasks.AuditBoundaryConsumer do
  use Boundary, classify_to: Oli
  use Mix.Task

  @impl Mix.Task
  def run(_args), do: Oli.Accounts.Audited.__info__(:functions)
end
